{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bigscreen-window",
  "description": "Full-screen television window with local data events and controlled focus.",
  "windows": ["bigscreen", "bigscreen-probe"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-fullscreen"
  ]
}
